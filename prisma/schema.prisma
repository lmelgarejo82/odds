generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Source {
  FOREBET
  STATAREA
  RESULT
}

enum ArtifactStatus {
  PENDING
  CAPTURED
  PARSED
  COMPLETE
  PARTIAL
  UNKNOWN
  FAILED
  BLOCKED
}

enum MatchStatus {
  SCHEDULED
  FINISHED
  POSTPONED
  CANCELLED
  UNKNOWN
}

enum ReconciliationStatus {
  MATCHED
  AMBIGUOUS
  ONLY_FOREBET
  ONLY_STATAREA
  CONFLICT
}

enum ResultStatus {
  PROVISIONAL
  CONFIRMED
  CORRECTED
  VOID
}

enum ReportStatus {
  DRAFT
  GENERATED
  FAILED
}

enum RankingStatus {
  DRAFT
  GENERATED
  REVIEWED
  CLOSED
}

enum SuggestedSide {
  OVER_2_5
  UNDER_2_5
  NO_SUGGESTION
}

enum EvidenceGrade {
  A
  B
  C
  EXPERIMENTAL
  INSUFFICIENT
}

enum TrackingStatus {
  PENDING
  HIT
  MISS
  VOID
  NOT_EVALUABLE
}

enum ResearchStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum ForebetCaptureStatus {
  SUCCEEDED
  PARTIAL
  FAILED
  REUSED
}

enum ForebetRowStatus {
  VALID
  WARNING
  REJECTED
}

enum ForebetOuSide {
  OVER
  UNDER
}

enum StatareaSemanticStatus {
  VERIFIED
  STRUCTURALLY_MAPPED
  STRUCTURALLY_MAPPED_WITH_LABEL_EVIDENCE
  UNVERIFIED
  CONFLICTING
  NOT_APPLICABLE
}

enum StatareaSourcePresentation {
  MODERN
  LEGACY_OFFICIAL
}

enum StatareaRowStatus {
  VALID
  WARNING
  REJECTED
}

enum MatchRunType {
  PRIMARY
  STABILITY_DIAGNOSTIC
  HISTORICAL_DATASET
  PROSPECTIVE_SHADOW
}

enum HistoricalPartition {
  DISCOVERY
  VALIDATION
}

enum HistoricalDatasetStatus {
  BUILDING
  PARTIAL
  FAILED
  FROZEN
  REUSED
}

enum SemanticEvidenceStatus {
  VERIFIED
}

enum SemanticFieldStatus {
  VERIFIED_DIRECT
  VERIFIED_DERIVED
  UNVERIFIED
  NOT_APPLICABLE
}

enum SemanticQualityStatus {
  READY
  READY_WITH_WARNINGS
  INSUFFICIENT
  REJECTED
}

enum SemanticAssessmentStatus {
  COMPLETED
}

enum SemanticAssessmentAttemptStatus {
  CREATED
  REUSED
  FAILED
}

enum SemanticFindingSeverity {
  INFO
  WARNING
  ERROR
}

enum MatchRunStatus {
  COMPLETED
}

enum MatchOrientation {
  DIRECT
  REVERSED
}

enum MatchConfidenceClass {
  EXACT
  STRONG
  REVIEW
  UNRESOLVED
}

model SourceArtifact {
  id                String                   @id @default(cuid())
  source            Source
  requestedDate     DateTime
  sourceUrl         String
  captureMethod     String
  contentHash       String                   @unique
  byteSize          Int
  parserVersion     String
  storagePath       String
  capturedAt        DateTime
  status            ArtifactStatus
  createdAt         DateTime                 @default(now())
  forebetSnapshots  ForebetOuSnapshot[]
  statareaSnapshots StatareaSnapshot[]
  results           MatchResult[]
  forebetCaptures   ForebetCaptureSnapshot[]
}

model ForebetCaptureAttempt {
  id            String                  @id @default(cuid())
  requestedDate DateTime
  requestedUrl  String
  finalUrl      String?
  capturedAt    DateTime
  httpStatus    Int?
  contentType   String?
  byteSize      Int?
  contentHash   String?
  parserVersion String
  status        ForebetCaptureStatus
  warning       String?
  errorCode     String?
  snapshotId    String?
  createdAt     DateTime                @default(now())
  snapshot      ForebetCaptureSnapshot? @relation(fields: [snapshotId], references: [id])
}

model ForebetCaptureSnapshot {
  id               String                  @id @default(cuid())
  sourceArtifactId String
  requestedDate    DateTime
  contentHash      String
  parserVersion    String
  evidencePath     String
  rowsFound        Int
  validRows        Int
  rejectedRows     Int
  duplicateRows    Int
  warningCount     Int
  createdAt        DateTime                @default(now())
  artifact         SourceArtifact          @relation(fields: [sourceArtifactId], references: [id])
  attempts         ForebetCaptureAttempt[]
  observations     ForebetObservation[]
  rejections       ForebetRowRejection[]

  @@unique([requestedDate, contentHash, parserVersion])
}

model ForebetObservation {
  id                 String                 @id @default(cuid())
  snapshotId         String
  source             Source                 @default(FOREBET)
  sportDate          DateTime
  homeTeamRaw        String
  awayTeamRaw        String
  competitionRaw     String?
  countryRaw         String?
  categoryRaw        String?
  kickoffRaw         String?
  suggestedSide      ForebetOuSide
  probabilityUnder25 Decimal?
  probabilityOver25  Decimal?
  predictedHomeGoals Int?
  predictedAwayGoals Int?
  averageGoals       Decimal?
  sourceOdds         Decimal?
  sourceRowKey       String
  parserVersion      String
  parseStatus        ForebetRowStatus
  warningsJson       String
  createdAt          DateTime               @default(now())
  snapshot           ForebetCaptureSnapshot @relation(fields: [snapshotId], references: [id])

  @@unique([snapshotId, sourceRowKey])
}

model ForebetRowRejection {
  id           String                 @id @default(cuid())
  snapshotId   String
  rowIndex     Int
  sourceRowKey String?
  reasonCode   String
  detailsJson  String
  createdAt    DateTime               @default(now())
  snapshot     ForebetCaptureSnapshot @relation(fields: [snapshotId], references: [id])

  @@unique([snapshotId, rowIndex])
}

model ForebetCaptureAuditEvent {
  id            String   @id @default(cuid())
  eventType     String
  requestedDate DateTime
  snapshotId    String?
  detailsJson   String
  createdAt     DateTime @default(now())
}

model StatareaCaptureAttempt {
  id            String                   @id @default(cuid())
  requestedDate DateTime
  requestedUrl  String
  finalUrl      String?
  hostname      String?
  capturedAt    DateTime
  httpStatus    Int?
  contentType   String?
  byteSize      Int?
  contentHash   String?
  parserVersion String
  status        ForebetCaptureStatus
  warning       String?
  errorCode     String?
  snapshotId    String?
  createdAt     DateTime                 @default(now())
  snapshot      StatareaCaptureSnapshot? @relation(fields: [snapshotId], references: [id])
}

model StatareaCaptureSnapshot {
  id                   String                   @id @default(cuid())
  requestedDate        DateTime
  contentHash          String
  parserVersion        String
  evidencePath         String
  exportPath           String
  rawHeadersJson       String
  semanticRegistryJson String
  rowsFound            Int
  validRows            Int
  rejectedRows         Int
  duplicateRows        Int
  warningCount         Int
  createdAt            DateTime                 @default(now())
  attempts             StatareaCaptureAttempt[]
  rows                 StatareaRawRow[]
  rejections           StatareaRowRejection[]
  profile              StatareaSnapshotProfile?

  @@unique([requestedDate, contentHash, parserVersion])
}

model StatareaSnapshotProfile {
  id                   String                     @id
  snapshotId           String                     @unique
  sourcePresentation   StatareaSourcePresentation
  endpointTemplate     String
  requestedUrl         String
  finalUrl             String
  parserVersion        String
  capturePolicyVersion String
  createdAt            DateTime                   @default(now())
  snapshot             StatareaCaptureSnapshot    @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
}

model StatareaRawRow {
  id                       String                       @id @default(cuid())
  snapshotId               String
  source                   Source                       @default(STATAREA)
  requestedDate            DateTime
  rowDateRaw               String?
  kickoffRaw               String?
  competitionRaw           String?
  countryRaw               String?
  categoryRaw              String?
  homeTeamRaw              String
  awayTeamRaw              String
  orientation              String
  rowTextRaw               String?
  rawColumnsJson           String
  structuralAttributesJson String
  sourceRowKey             String
  parserVersion            String
  parseStatus              StatareaRowStatus
  semanticStatus           StatareaSemanticStatus
  warningsJson             String
  createdAt                DateTime                     @default(now())
  snapshot                 StatareaCaptureSnapshot      @relation(fields: [snapshotId], references: [id])
  semanticProjections      StatareaSemanticProjection[]

  @@unique([snapshotId, sourceRowKey])
}

model StatareaRowRejection {
  id           String                  @id @default(cuid())
  snapshotId   String
  rowIndex     Int
  sourceRowKey String?
  reasonCode   String
  detailsJson  String
  createdAt    DateTime                @default(now())
  snapshot     StatareaCaptureSnapshot @relation(fields: [snapshotId], references: [id])

  @@unique([snapshotId, rowIndex])
}

model StatareaCaptureAuditEvent {
  id            String   @id @default(cuid())
  eventType     String
  requestedDate DateTime
  snapshotId    String?
  detailsJson   String
  createdAt     DateTime @default(now())
}

model MatchRun {
  id                 String            @id @default(cuid())
  sportDate          DateTime
  forebetSnapshotId  String
  forebetSha256      String
  statareaSnapshotId String
  statareaSha256     String
  matcherVersion     String
  normalizerVersion  String
  configurationHash  String
  configurationJson  String
  runType            MatchRunType
  datasetId          String?
  status             MatchRunStatus
  forebetInputCount  Int
  statareaInputCount Int
  matchedCount       Int
  ambiguousCount     Int
  onlyForebetCount   Int
  onlyStatareaCount  Int
  conflictCount      Int
  exactCount         Int
  conservativeCount  Int
  approximateCount   Int
  warningsJson       String
  exportPath         String
  createdAt          DateTime          @default(now())
  candidates         MatchCandidate[]
  decisions          MatchDecision[]
  attempts           MatchRunAttempt[]

  @@unique([sportDate, forebetSnapshotId, statareaSnapshotId, matcherVersion, normalizerVersion, configurationHash, runType])
}

model MatchRunAttempt {
  id        String   @id @default(cuid())
  runId     String
  status    String
  createdAt DateTime @default(now())
  run       MatchRun @relation(fields: [runId], references: [id])
}

model MatchCandidate {
  id                   String           @id @default(cuid())
  runId                String
  forebetObservationId String?
  statareaRowId        String?
  orientation          MatchOrientation
  homeScore            Float
  awayScore            Float
  competitionEvidence  String
  countryEvidence      String
  categoryEvidence     String
  aggregateScore       Float
  marginToSecond       Float?
  stage                String
  evidenceJson         String
  rejectionReasonsJson String
  rank                 Int
  createdAt            DateTime         @default(now())
  run                  MatchRun         @relation(fields: [runId], references: [id])

  @@unique([runId, forebetObservationId, statareaRowId, orientation])
}

model MatchDecision {
  id                   String               @id @default(cuid())
  runId                String
  status               ReconciliationStatus
  forebetObservationId String?
  statareaRowId        String?
  selectedCandidateId  String?
  reasonCode           String
  reasonsJson          String
  warningsJson         String
  confidenceClass      MatchConfidenceClass
  createdAt            DateTime             @default(now())
  run                  MatchRun             @relation(fields: [runId], references: [id])

  @@index([runId, status])
}

model MatchAuditEvent {
  id          String   @id @default(cuid())
  runId       String?
  eventType   String
  detailsJson String
  createdAt   DateTime @default(now())
}

model MatchStabilityReport {
  id                    String   @id @default(cuid())
  sportDate             DateTime
  primaryRunId          String
  alternativeRunIdsJson String
  reportHash            String
  reportJson            String
  exportPath            String
  createdAt             DateTime @default(now())

  @@unique([primaryRunId, reportHash])
}

model HistoricalDataset {
  id                       String                           @id
  code                     String
  version                  String
  dateFrom                 DateTime
  dateTo                   DateTime
  discoveryFrom            DateTime
  discoveryTo              DateTime
  validationFrom           DateTime
  validationTo             DateTime
  capturePolicyVersion     String
  matcherVersion           String
  normalizerVersion        String
  matcherConfigurationHash String
  warningsJson             String
  createdAt                DateTime                         @default(now())
  days                     HistoricalDatasetDay[]
  imports                  HistoricalImportRun[]
  policies                 HistoricalDatasetCapturePolicy[]
  semanticAssessmentRuns   SemanticAssessmentRun[]

  @@unique([code, version])
}

model HistoricalDatasetCapturePolicy {
  id                  String                     @id
  datasetId           String
  version             String
  sourcePresentation  StatareaSourcePresentation
  endpointTemplate    String
  concurrency         Int
  minimumPauseMs      Int
  timeoutMs           Int
  maxBytes            Int
  maxRedirects        Int
  maxTechnicalRetries Int
  createdAt           DateTime                   @default(now())
  dataset             HistoricalDataset          @relation(fields: [datasetId], references: [id], onDelete: Restrict)

  @@unique([datasetId, version])
}

model HistoricalDatasetDay {
  id                         String                      @id
  datasetId                  String
  sportsDate                 DateTime
  partition                  HistoricalPartition
  forebetSnapshotId          String
  forebetSha256              String
  statareaSnapshotId         String
  statareaSha256             String
  forebetParserVersion       String
  statareaParserVersion      String
  statareaProfileId          String?
  statareaSourcePresentation StatareaSourcePresentation?
  matchRunId                 String
  sourceCountsJson           String
  matchCountsJson            String
  qualityStatus              String
  selectionReasonsJson       String
  warningsJson               String
  createdAt                  DateTime                    @default(now())
  dataset                    HistoricalDataset           @relation(fields: [datasetId], references: [id])

  @@unique([datasetId, sportsDate])
  @@unique([datasetId, forebetSnapshotId])
  @@unique([datasetId, statareaSnapshotId])
  @@unique([datasetId, matchRunId])
}

model HistoricalImportRun {
  id                    String            @id
  datasetId             String
  requestedDatesJson    String
  initialCompletedDates Int
  networkRequestCount   Int
  warningsJson          String
  startedAt             DateTime          @default(now())
  dataset               HistoricalDataset @relation(fields: [datasetId], references: [id])
}

model HistoricalImportTask {
  id                 String                      @id @default(cuid())
  importRunId        String
  datasetId          String
  sportsDate         DateTime
  source             Source
  sourcePresentation StatareaSourcePresentation?
  attemptId          String?
  snapshotId         String?
  state              String
  reason             String
  createdAt          DateTime                    @default(now())
}

model HistoricalDatasetState {
  id                 String                  @id @default(cuid())
  datasetId          String
  status             HistoricalDatasetStatus
  completedDates     Int
  failedDates        Int
  manifestHash       String?
  manifestExportPath String?
  detailsJson        String
  createdAt          DateTime                @default(now())
}

model HistoricalAuditEvent {
  id          String    @id @default(cuid())
  datasetId   String
  importRunId String?
  eventType   String
  sportsDate  DateTime?
  source      Source?
  detailsJson String
  createdAt   DateTime  @default(now())
}

model FootballMatch {
  id                String              @id @default(cuid())
  canonicalKey      String              @unique
  sportDate         DateTime
  kickoffText       String
  kickoffUtc        DateTime?
  country           String
  competition       String
  homeTeam          String
  awayTeam          String
  category          String
  status            MatchStatus
  createdAt         DateTime            @default(now())
  forebetSnapshots  ForebetOuSnapshot[]
  statareaSnapshots StatareaSnapshot[]
  forebetLinks      CrossSourceMatch[]  @relation("ForebetMatch")
  statareaLinks     CrossSourceMatch[]  @relation("StatareaMatch")
  results           MatchResult[]
}

model ForebetOuSnapshot {
  id                 String         @id @default(cuid())
  matchId            String
  sourceArtifactId   String
  probabilityUnder25 Decimal
  probabilityOver25  Decimal
  prediction         String
  predictedHomeGoals Decimal
  predictedAwayGoals Decimal
  averageGoals       Decimal
  sourceOdds         String?
  sourceRowHash      String         @unique
  parserVersion      String
  createdAt          DateTime       @default(now())
  match              FootballMatch  @relation(fields: [matchId], references: [id])
  artifact           SourceArtifact @relation(fields: [sourceArtifactId], references: [id])
}

model StatareaSnapshot {
  id                      String         @id @default(cuid())
  matchId                 String
  sourceArtifactId        String
  homeProbability         Decimal
  drawProbability         Decimal
  awayProbability         Decimal
  halftimeHomeProbability Decimal
  halftimeDrawProbability Decimal
  halftimeAwayProbability Decimal
  over15Value             Decimal
  over25Value             Decimal
  over35Value             Decimal
  btsValue                Decimal
  otsValue                Decimal
  tip                     String
  sourceRowHash           String         @unique
  parserVersion           String
  createdAt               DateTime       @default(now())
  match                   FootballMatch  @relation(fields: [matchId], references: [id])
  artifact                SourceArtifact @relation(fields: [sourceArtifactId], references: [id])
}

model CrossSourceMatch {
  id                  String                 @id @default(cuid())
  forebetMatchId      String?
  statareaMatchId     String?
  status              ReconciliationStatus
  matchingMethod      String
  matchingScore       Decimal
  matchingDetailsJson String
  confirmedAt         DateTime?
  createdAt           DateTime               @default(now())
  forebetMatch        FootballMatch?         @relation("ForebetMatch", fields: [forebetMatchId], references: [id])
  statareaMatch       FootballMatch?         @relation("StatareaMatch", fields: [statareaMatchId], references: [id])
  candidates          DailyRankedCandidate[]
}

model MatchResult {
  id               String         @id @default(cuid())
  matchId          String
  homeGoals        Int
  awayGoals        Int
  status           ResultStatus
  sourceArtifactId String
  resultHash       String         @unique
  correctsResultId String?
  createdAt        DateTime       @default(now())
  match            FootballMatch  @relation(fields: [matchId], references: [id])
  artifact         SourceArtifact @relation(fields: [sourceArtifactId], references: [id])
  corrects         MatchResult?   @relation("ResultCorrections", fields: [correctsResultId], references: [id])
  corrections      MatchResult[]  @relation("ResultCorrections")
}

model ResearchConfiguration {
  id                String         @id @default(cuid())
  code              String
  version           String
  status            ResearchStatus
  active            Boolean        @default(false)
  configurationJson String
  configurationHash String         @unique
  createdAt         DateTime       @default(now())

  @@unique([code, version])
}

model AnalysisSpecification {
  id                String                     @id @default(cuid())
  code              String
  version           String
  engineVersion     String
  configurationJson String
  configurationHash String                     @unique
  createdAt         DateTime                   @default(now())
  reports           HistoricalAnalysisReport[]
  rankings          DailyRanking[]

  @@unique([code, version])
}

model HistoricalAnalysisReport {
  id              String                @id @default(cuid())
  reportId        String                @unique
  specificationId String
  periodFrom      DateTime
  periodTo        DateTime
  status          ReportStatus
  sourceDataHash  String
  payloadJson     String
  payloadHash     String                @unique
  createdAt       DateTime              @default(now())
  specification   AnalysisSpecification @relation(fields: [specificationId], references: [id])
}

model DailyRanking {
  id                      String                 @id @default(cuid())
  rankingDate             DateTime
  analysisSpecificationId String
  status                  RankingStatus
  generatedAt             DateTime
  sourceDataHash          String
  createdAt               DateTime               @default(now())
  specification           AnalysisSpecification  @relation(fields: [analysisSpecificationId], references: [id])
  candidates              DailyRankedCandidate[]

  @@unique([rankingDate, analysisSpecificationId, sourceDataHash])
}

model DailyRankedCandidate {
  id                      String               @id @default(cuid())
  dailyRankingId          String
  crossSourceMatchId      String
  suggestedSide           SuggestedSide
  priorityScore           Int
  signalScore             Int
  historicalEvidenceScore Int
  dataQualityScore        Int
  evidenceGrade           EvidenceGrade
  rank                    Int
  reasonsJson             String
  warningsJson            String
  explanationHash         String               @unique
  createdAt               DateTime             @default(now())
  ranking                 DailyRanking         @relation(fields: [dailyRankingId], references: [id])
  crossSourceMatch        CrossSourceMatch     @relation(fields: [crossSourceMatchId], references: [id])
  observations            TrackedObservation[]

  @@unique([dailyRankingId, rank])
}

model TrackedObservation {
  id                String               @id @default(cuid())
  rankedCandidateId String
  status            TrackingStatus
  outcome           String?
  capturedAt        DateTime
  settledAt         DateTime?
  createdAt         DateTime             @default(now())
  rankedCandidate   DailyRankedCandidate @relation(fields: [rankedCandidateId], references: [id])
}

model AuditEvent {
  id          String   @id @default(cuid())
  eventType   String
  entityType  String
  entityId    String
  detailsJson String
  createdAt   DateTime @default(now())

  @@unique([eventType, entityType, entityId])
}

model SemanticRegistry {
  id                 String                      @id @default(cuid())
  code               String
  version            String
  source             Source
  sourcePresentation StatareaSourcePresentation
  parserVersion      String
  evidenceStatus     SemanticEvidenceStatus
  legendSha256       String
  registryHash       String                      @unique
  warningsJson       String
  createdAt          DateTime                    @default(now())
  definitions        SemanticFieldDefinition[]
  assessmentRuns     SemanticAssessmentRun[]
  assessmentAttempts SemanticAssessmentAttempt[]
  auditEvents        SemanticAuditEvent[]

  @@unique([code, version])
}

model SemanticFieldDefinition {
  id                String              @id @default(cuid())
  registryId        String
  rawHeader         String?
  canonicalField    String
  meaning           String
  unit              String
  direction         String?
  line              Decimal?
  semanticStatus    SemanticFieldStatus
  evidenceLevel     String
  evidenceJson      String
  normalizationRule String
  derivationRule    String?
  analysisEnabled   Boolean             @default(false)
  createdAt         DateTime            @default(now())
  registry          SemanticRegistry    @relation(fields: [registryId], references: [id], onDelete: Restrict)

  @@unique([registryId, canonicalField])
}

model SemanticAssessmentRun {
  id                 String                       @id @default(cuid())
  registryId         String
  datasetId          String
  manifestHash       String
  assessmentVersion  String
  status             SemanticAssessmentStatus
  rowCount           Int
  matchedCount       Int
  qualitySummaryJson String
  createdAt          DateTime                     @default(now())
  registry           SemanticRegistry             @relation(fields: [registryId], references: [id], onDelete: Restrict)
  dataset            HistoricalDataset            @relation(fields: [datasetId], references: [id], onDelete: Restrict)
  attempts           SemanticAssessmentAttempt[]
  projections        StatareaSemanticProjection[]
  findings           SemanticQualityFinding[]
  auditEvents        SemanticAuditEvent[]

  @@unique([registryId, datasetId, manifestHash, assessmentVersion])
}

model SemanticAssessmentAttempt {
  id                    String                          @id @default(cuid())
  assessmentRunId       String?
  registryId            String
  datasetId             String
  status                SemanticAssessmentAttemptStatus
  reusedAssessmentRunId String?
  warningsJson          String
  createdAt             DateTime                        @default(now())
  assessmentRun         SemanticAssessmentRun?          @relation(fields: [assessmentRunId], references: [id], onDelete: Restrict)
  registry              SemanticRegistry                @relation(fields: [registryId], references: [id], onDelete: Restrict)
}

model StatareaSemanticProjection {
  id                          String                @id @default(cuid())
  assessmentRunId             String
  rawRowId                    String
  sportsDate                  DateTime
  partition                   HistoricalPartition
  sourceHomeWinPercent        Decimal?
  sourceDrawPercent           Decimal?
  sourceAwayWinPercent        Decimal?
  sourceDoubleChance1XPercent Decimal?
  sourceDoubleChanceX2Percent Decimal?
  sourceDoubleChance12Percent Decimal?
  sourceHtHomeWinPercent      Decimal?
  sourceHtDrawPercent         Decimal?
  sourceHtAwayWinPercent      Decimal?
  sourceOver15Percent         Decimal?
  sourceUnder15Percent        Decimal?
  sourceOver25Percent         Decimal?
  sourceUnder25Percent        Decimal?
  sourceOver35Percent         Decimal?
  sourceUnder35Percent        Decimal?
  sourceHandicap01HomePercent Decimal?
  sourceHandicap01DrawPercent Decimal?
  sourceHandicap01AwayPercent Decimal?
  ou25SemanticReady           Boolean               @default(false)
  doubleChanceSemanticReady   Boolean               @default(false)
  htSemanticReady             Boolean               @default(false)
  handicap01SemanticReady     Boolean               @default(false)
  semanticReadiness           SemanticQualityStatus
  qualityStatus               SemanticQualityStatus
  warningsJson                String
  createdAt                   DateTime              @default(now())
  assessmentRun               SemanticAssessmentRun @relation(fields: [assessmentRunId], references: [id], onDelete: Restrict)
  rawRow                      StatareaRawRow        @relation(fields: [rawRowId], references: [id], onDelete: Restrict)

  @@unique([assessmentRunId, rawRowId])
  @@index([sportsDate, partition])
}

model SemanticQualityFinding {
  id              String                  @id @default(cuid())
  assessmentRunId String
  rawRowId        String?
  sportsDate      DateTime?
  field           String
  findingType     String
  severity        SemanticFindingSeverity
  observedValue   String?
  expectedRule    String
  detailsJson     String
  createdAt       DateTime                @default(now())
  assessmentRun   SemanticAssessmentRun   @relation(fields: [assessmentRunId], references: [id], onDelete: Restrict)

  @@index([assessmentRunId, field, findingType])
}

model SemanticAuditEvent {
  id              String                 @id @default(cuid())
  assessmentRunId String?
  registryId      String?
  eventType       String
  contextJson     String
  createdAt       DateTime               @default(now())
  assessmentRun   SemanticAssessmentRun? @relation(fields: [assessmentRunId], references: [id], onDelete: Restrict)
  registry        SemanticRegistry?      @relation(fields: [registryId], references: [id], onDelete: Restrict)

  @@index([eventType, createdAt])
}

model HistoricalAnalysisSpec {
  id                          String   @id @default(cuid())
  code                        String
  version                     String
  datasetId                   String
  manifestHash                String
  registryHash                String
  outcomePolicyVersion        String
  engineVersion               String
  specHash                    String
  status                      String
  canonicalSpecJson           String
  resultEvidenceCountAtFreeze Int      @default(0)
