model ProspectiveAuditEvent {
  id               String                @id @default(cuid())
  prospectiveRunId String?
  eventType        String
  contextJson      String
  createdAt        DateTime              @default(now())
  run              ProspectiveShadowRun? @relation(fields: [prospectiveRunId], references: [id], onDelete: Restrict)

  @@index([eventType, createdAt])
}
