{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "historical-ou25-analysis-report.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reportId", "period", "status", "sides"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "reportId": { "type": "string", "minLength": 1 },
    "period": { "type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": { "from": { "type": "string", "format": "date" }, "to": { "type": "string", "format": "date" } } },
    "status": { "enum": ["DRAFT", "GENERATED", "FAILED"] },
    "sides": { "type": "object", "additionalProperties": false, "required": ["over25", "under25"], "properties": { "over25": { "$ref": "#/$defs/side" }, "under25": { "$ref": "#/$defs/side" } } }
  },
  "$defs": { "side": { "type": "object", "additionalProperties": false, "required": ["sampleSize"], "properties": { "sampleSize": { "type": "integer", "minimum": 0 } } } }
}
