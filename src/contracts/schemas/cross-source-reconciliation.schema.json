{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cross-source-reconciliation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestedDate", "matches"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "requestedDate": { "type": "string", "format": "date" },
    "matches": { "type": "array", "items": { "$ref": "#/$defs/match" } }
  },
  "$defs": { "match": {
    "type": "object", "additionalProperties": false,
    "required": ["canonicalKey", "status", "matchingMethod", "matchingScore"],
    "properties": {
      "canonicalKey": { "type": "string", "minLength": 1 },
      "status": { "enum": ["MATCHED", "AMBIGUOUS", "ONLY_FOREBET", "ONLY_STATAREA", "CONFLICT"] },
      "matchingMethod": { "type": "string", "minLength": 1 },
      "matchingScore": { "type": "number", "minimum": 0, "maximum": 1 }
    }
  }}
}
